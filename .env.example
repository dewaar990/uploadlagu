# ===== Server =====
PORT=3000
# Set true bila web dijalankan di belakang HTTPS (cookie Secure)
COOKIE_SECURE=false
# Set true bila di belakang reverse proxy (nginx, Railway, Render, dll.)
TRUST_PROXY=false
# Rahasia untuk tanda tangan sesi & enkripsi API key pelanggan.
# Kosongkan = dibuat otomatis di data/secret.key
SESSION_SECRET=

# ===== Akun admin (hanya admin yang bisa membuat ID pelanggan & password) =====
ADMIN_ID=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# ===== Default Roblox Open Cloud (opsional) =====
# Dipakai admin, dan pelanggan yang diizinkan "memakai API key server".
# Scope API key: asset:read, asset:write,
#   universe-datastores.objects:read, universe-datastores.objects:create, universe-datastores.objects:update
ROBLOX_API_KEY=
# Opsional: API key terpisah khusus DataStore (default: sama dengan ROBLOX_API_KEY)
ROBLOX_DATASTORE_API_KEY=
# user atau group
ROBLOX_CREATOR_TYPE=user
ROBLOX_CREATOR_ID=
ROBLOX_UNIVERSE_ID=

# ===== DataStore =====
DATASTORE_NAME=songiddeerizcorp
DATASTORE_SCOPE=global
# list   = semua SoundId disimpan dalam array pada satu key (DATASTORE_ENTRY_KEY)
# per-id = setiap SoundId jadi key sendiri
DATASTORE_MODE=list
DATASTORE_ENTRY_KEY=SongList

# ===== Audio =====
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
AUDIO_BITRATE=192k
MAX_AUDIO_SECONDS=420
MAX_UPLOAD_MB=100

# ===== Polling moderasi =====
MODERATION_POLL_MS=5000
MODERATION_TIMEOUT_MS=600000
BACKGROUND_RECHECK_MS=300000
